#!/bin/bash
# Stop only the hourly probe this project started.
set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "$0")" && pwd)
PID_FILE="$PROJECT_DIR/.deploy/test-d1-probe-hourly.pid"

[ -f "$PID_FILE" ] || { echo "The hourly test-D1 probe is not running."; exit 0; }
pid=$(tr -d '\r\n' <"$PID_FILE")
command=$(ps -p "$pid" -o command= 2>/dev/null || true)
case "$command" in
    *"$PROJECT_DIR/probe-test-d1-hourly"*)
        kill "$pid"
        rm -f "$PID_FILE"
        echo "Stopped the hourly test-D1 probe (process $pid)."
        ;;
    *)
        rm -f "$PID_FILE"
        echo "The recorded hourly probe process is no longer running."
        ;;
esac
