#!/bin/bash
# Stores one of the release credentials in this computer's own credential
# store: the keychain on macOS, Windows Credential Manager on Windows. It asks
# for the value without showing it; the value never appears on a command line,
# in a file or in a repository.
#
#   ./store-secret foodbank-charity-cloudflare-api-token
#   ./store-secret foodbank-resend-api-key
#
# Storing a name again replaces its value.
set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=lib/deploy-common.sh
. "$PROJECT_DIR/lib/deploy-common.sh"
# shellcheck source=lib/platform.sh
. "$PROJECT_DIR/lib/platform.sh"

case "${1:-}" in
    foodbank-charity-cloudflare-api-token | foodbank-resend-api-key) ;;
    -h | --help | "") sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown name: $1. It is one of foodbank-charity-cloudflare-api-token or foodbank-resend-api-key." ;;
esac
require_supported_platform

store_secret "$1" || die "nothing was stored."
say "Stored $1 in $(secret_store_name). Run ./check-setup to check it works."
