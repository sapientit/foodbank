#!/bin/bash
# Installs this machine's daily 04:17 test-D1 probe.  The operating-system
# schedule and this marker are local state; neither is committed.
set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "$0")" && pwd)
MARKER="$PROJECT_DIR/test-d1-probe.local"

# shellcheck source=lib/deploy-common.sh
. "$PROJECT_DIR/lib/deploy-common.sh"
# shellcheck source=lib/platform.sh
. "$PROJECT_DIR/lib/platform.sh"

require_supported_platform
[ -x "$PROJECT_DIR/probe-test-d1" ] || die "probe-test-d1 is missing or is not executable."

schedule_test_d1_probe "$PROJECT_DIR"
printf 'installed=04:17 London local time\n' >"$MARKER"
echo "Installed the daily test-D1 probe for 04:17 local time."
echo "Run ./probe-test-d1 now for the same read-only check; logs are in .deploy/."
